<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="using:Sdl.MultiSelectComboBox.Example.Models">

    <DataTemplate x:Key="MultiSelectComboBox.SelectedItems.ItemTemplate">
        <StackPanel Orientation="Horizontal" Margin="0,-4">
            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="2,0" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="MultiSelectComboBox.SelectedItems.Custom.ItemTemplate">
        <StackPanel Orientation="Horizontal" Margin="0,-4">
            <TextBlock VerticalAlignment="Center" Margin="2,0">
                <Run Text="["/><Run FontWeight="Bold" Foreground="#FF4F68AA" Text="{Binding CultureInfo.Name}"/><Run Text="]"/>
                <Run Text="{Binding Name}"/>
            </TextBlock>
        </StackPanel>
    </DataTemplate>

</ResourceDictionary>
