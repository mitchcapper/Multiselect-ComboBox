                <Setter Property="Margin" Value="0"/>
            </Style>-->

    <Grid Margin="15">
        <!--<Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="Styles/MultiSelectComboBox.Custom.ControlTemplate.xaml"/>
                    <ResourceDictionary Source="Styles/MultiSelectComboBox.Custom.DropdownItemTemplate.xaml"/>
                    <ResourceDictionary Source="Styles/MultiSelectComboBox.Custom.SelectedItemTemplate.xaml"/>
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>-->

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,2,25" MinWidth="150" Width="Auto" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text ="Items" Margin="0,5,0,0" HorizontalAlignment="Left" FontWeight="SemiBold" Width="120" Height="21" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0" Height="21" VerticalAlignment="Top">
                        <TextBlock Text="{x:Bind ViewModel.SelectedItemsCount, Mode=OneWay}" FontWeight="SemiBold"/>
                        <TextBlock Text=" Selected" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,25,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="100" MinHeight="49" MaxHeight="300" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <sdl:MultiSelectComboBox Margin="0,0,0,20"
                                                 Visibility="Visible"
                                                 ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                                                 FilterService="{x:Bind ViewModel.FilterService, Mode=OneWay}"
                                                 SuggestionProvider="{x:Bind ViewModel.CustomSuggestionProvider, Mode=OneWay}"
                                                 />
						<!--AutoCompleteService="{x:Bind ViewModel.AutoCompleteService, Mode=OneWay}"-->

						<sdl:MultiSelectComboBox Margin="0,0,0,20"
                                                 Visibility="Collapsed"
                                                 ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                                                 FilterService="{x:Bind ViewModel.FilterService, Mode=OneWay}"
                                                 SuggestionProvider="{x:Bind ViewModel.CustomSuggestionProvider, Mode=OneWay}"
                                                 />

                        <Button Command="{x:Bind ViewModel.ClearItemsCommand, Mode=OneWay}" Style="{StaticResource Custom.Button.Style}"  Width="128" Height="20">
                            <TextBlock Text="Clear selected items" TextDecorations="Underline"/>
                        </Button>
                    </Grid>

                    <Border Height="2" Grid.Row="1" Margin="5,0,5,0" HorizontalAlignment="Stretch" Background="LightGray"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,5,0,0">
                        <Border BorderBrush="LightGray" BorderThickness="1">
                            <StackPanel Margin="10" Spacing="10">
                                <TextBlock Text ="Demo Settings" FontWeight="SemiBold" />

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Style:" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Vertical">
                                        <RadioButton x:Name="RadioButtonDefaultStyle" GroupName="Style" Content="Default control template style" IsChecked="True" Command="{x:Bind ViewModel.StyleChangedCommand, Mode=OneWay}"/>
                                        <RadioButton x:Name="RadioButtonCustomStyle" GroupName="Style" Content="Custom control template style" Command="{x:Bind ViewModel.StyleChangedCommand, Mode=OneWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Content="Select 20 random items" Command="{x:Bind ViewModel.SelectRandomItemsCommand, Mode=OneWay}" Width="184" HorizontalAlignment="Left"/>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Selection Mode:" VerticalAlignment="Center"/>
                                    <ComboBox SelectedItem="{x:Bind ViewModel.SelectionMode, Mode=TwoWay}" ItemsSource="{x:Bind ViewModel.SelectionModes, Mode=OneWay}" Width="150"/>
                                </StackPanel>

                                <CheckBox Content="Clear Filter Criteria as Dropdown (with Keyboard focus) is closing" IsChecked="{x:Bind ViewModel.ClearFilterOnDropdownClosing, Mode=TwoWay}" />

                                <CheckBox Content="Items in the 'Selected Items Panel' are editable" IsChecked="{x:Bind ViewModel.IsEditable, Mode=TwoWay}" />

                                <CheckBox Content="Enable/disable items (alternate)" IsChecked="{x:Bind ViewModel.EnableAlternateItems, Mode=TwoWay}" />

                                <CheckBox Content="Listen to 'Filter Text' changed" IsChecked="{x:Bind ViewModel.ListenToFilterTextChanged, Mode=TwoWay}" />
                                <CheckBox Content="Listen to 'Selected Items' changed" IsChecked="{x:Bind ViewModel.ListenToSelectedItemsChanged, Mode=TwoWay}" />

                                <CheckBox Content="Enable Autocomplete" IsChecked="{x:Bind ViewModel.EnableAutoComplete, Mode=TwoWay}" />
                                <CheckBox Content="Enable batch selection (paste support)" IsChecked="{x:Bind ViewModel.EnableBatchSelection, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.EnableAutoComplete, Mode=OneWay}" Margin="20,0,0,0"/>

                                <CheckBox Content="Enable grouping" IsChecked="{x:Bind ViewModel.EnableGrouping, Mode=TwoWay}" />
                                <CheckBox Content="Use 'Recently Used' service" IsChecked="{x:Bind ViewModel.UseRecentlyUsedGroupingService, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.EnableGrouping, Mode=OneWay}" Margin="20,0,0,0"/>

                                <CheckBox Content="Enable filtering" IsChecked="{x:Bind ViewModel.EnableFiltering, Mode=TwoWay}" />
                                <CheckBox Content="Use 'Custom Filter' service" IsChecked="{x:Bind ViewModel.UseCustomFilterService, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.EnableFiltering, Mode=OneWay}" Margin="20,0,0,0"/>

                                <CheckBox Content="Clear selection on filter changed (Single selection mode only)" IsChecked="{x:Bind ViewModel.ClearSelectionOnFilterChanged, Mode=TwoWay}" />

                                <CheckBox Content="Enable on demand service" IsChecked="{x:Bind ViewModel.EnableSuggestionProvider, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                </Grid>

            </Grid>

            <Border Width="2" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,25,0,40" Background="LightGray"/>

            <Grid Grid.Column="2" Width="Auto" MinWidth="150" Margin="2,0,0,0" >
                <TextBlock Text="Events Log" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="0,5,0,0" FontWeight="Medium" Height="26" />
                <ScrollViewer Margin="0,25,0,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TextBox Text="{x:Bind ViewModel.EventLog, Mode=OneWay}" TextWrapping="NoWrap" AcceptsReturn="True" IsReadOnly="True"/>
                </ScrollViewer>
                <Button Command="{x:Bind ViewModel.ClearLogCommand, Mode=OneWay}" Style="{StaticResource Custom.Button.Style}" Width="75" Height="24">
                    <TextBlock Text="Clear log" TextDecorations="Underline"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
